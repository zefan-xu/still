<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C6613F</item>
        <item name="android:colorControlActivated">#C6613F</item>
        <item name="android:colorControlHighlight">#14141413</item>
        <item name="android:textColorHighlight">#4DD97757</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAF9F5</item>
        <item name="android:navigationBarColor">#141413</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAF9F5</item>
        <!-- Figure tones: generated by tools/figures/build.mjs -->
        <item name="figPaper">#FAF9F5</item>
        <item name="figTop">#FFFFFF</item>
        <item name="figShade0">#E0DCD0</item>
        <item name="figShade1">#E7E4DA</item>
        <item name="figShade2">#EEECE4</item>
        <item name="figShade3">#F5F3ED</item>
        <item name="figHi">#3D3D3A</item>
        <item name="figMid">#7D7B73</item>
        <item name="figLo">#A9A69C</item>
        <item name="figFaint">#D6D3C8</item>
        <item name="figLit">#D97757</item>
        <item name="figLitEdge">#C6613F</item>
        <item name="figHalo">#5C6B6656</item>
        <item name="figGlass">#2B2A27</item>
        <item name="figGlassHi">#6A6862</item>
        <!-- End of figure tones -->
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="BaseAppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D97757</item>
        <item name="android:colorControlActivated">#D97757</item>
        <item name="android:colorControlHighlight">#1FFAF9F5</item>
        <item name="android:textColorHighlight">#4DD97757</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#1F1E1D</item>
        <item name="android:navigationBarColor">#1F1E1D</item>
        <item name="android:windowBackground">#1F1E1D</item>
        <!-- Figure tones: generated by tools/figures/build.mjs -->
        <item name="figPaper">#1F1E1D</item>
        <item name="figTop">#363531</item>
        <item name="figShade0">#191817</item>
        <item name="figShade1">#1F1E1C</item>
        <item name="figShade2">#252422</item>
        <item name="figShade3">#2C2B28</item>
        <item name="figHi">#D6D4CA</item>
        <item name="figMid">#85837A</item>
        <item name="figLo">#57554F</item>
        <item name="figFaint">#3B3A36</item>
        <item name="figLit">#D97757</item>
        <item name="figLitEdge">#E8977A</item>
        <item name="figHalo">#A6000000</item>
        <item name="figGlass">#121110</item>
        <item name="figGlassHi">#4A4844</item>
        <!-- End of figure tones -->
    </style>
    <style name="AppThemeDark" parent="BaseAppThemeDark" />

    <!-- The share sheet draws its own scrim over the app that shared the link. -->
    <style name="Still.Share" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Still.Share.Dark" parent="AppThemeDark">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Still.Viewer" parent="BaseAppThemeDark">
        <item name="android:windowBackground">#141413</item>
        <item name="android:statusBarColor">#141413</item>
        <item name="android:navigationBarColor">#141413</item>
    </style>
</resources>
