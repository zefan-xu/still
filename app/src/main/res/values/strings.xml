<?xml version="1.0" encoding="utf-8"?>
<!--
  IDs are area_element[_part]: the area is the screen or component (settings, links, sheet, …),
  action_ holds verbs shared by buttons and menus, and the part says how the text is used:
  _title for headings, _body for the paragraph under one, _summary for the second line of a row,
  _description for accessibility labels and _error for validation messages.
  Arguments are positional (%1$s, %1$d) so translations can reorder them.
-->
